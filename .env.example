DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
NOMINATIM_USER_AGENT="AmbulenceBooking/1.0 (Django emergency dispatch application)"
# SESSION_COOKIE_SECURE and CSRF_COOKIE_SECURE default to false in DEBUG
# and true otherwise. Override explicitly if your HTTPS/proxy setup requires it.

DB_ENGINE=mysql
DB_NAME=ambulance_db
DB_USER=root
DB_PASSWORD=replace-with-your-local-MySQL-root-password
DB_HOST=localhost
DB_PORT=3306

# Docker Compose only: a separate app account and MySQL root password.
MYSQL_APP_USER=ambulance_app
MYSQL_APP_PASSWORD=replace-with-a-unique-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-unique-local-password

# Optional Redis channel layer for multi-worker deployments.
# REDIS_URL=redis://localhost:6379/0

# Driver GPS write limits and server-side arrival validation.
DRIVER_GPS_MIN_INTERVAL_SECONDS=5
DRIVER_GPS_MIN_MOVEMENT_METERS=15
DRIVER_GPS_HEARTBEAT_SECONDS=60
DRIVER_ARRIVAL_RADIUS_METERS=150
DRIVER_ARRIVAL_MAX_ACCURACY_METERS=50
